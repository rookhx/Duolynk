rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isConversationMember(conversationId) {
      return isSignedIn() &&
        request.auth.uid in
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds;
    }

    function isMatchParticipant() {
      return isSignedIn() &&
        (
          request.auth.uid == resource.data.userId ||
          request.auth.uid == resource.data.partnerId
        );
    }

    function isMatchOwnerRequest() {
      return isSignedIn() && request.auth.uid == request.resource.data.userId;
    }

    match /users/{userId} {
      allow read, create, update: if isOwner(userId);
      allow delete: if false;

      match /devices/{deviceId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /questionnaires/{questionnaireId} {
        allow read, create, update: if isOwner(userId);
        allow delete: if false;
      }

      match /subscriptions/{subscriptionId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    match /matches/{matchId} {
      allow read: if isMatchParticipant();
      allow create: if isMatchOwnerRequest();
      allow update: if isMatchParticipant();
      allow delete: if false;
    }

    match /notification_jobs/{jobId} {
      allow read: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.userId;
      allow update, delete: if false;
    }

    match /conversations/{conversationId} {
      allow read: if isConversationMember(conversationId);

      allow create: if isSignedIn() &&
        request.auth.uid in request.resource.data.memberIds &&
        request.resource.data.memberIds.size() == 2;

      allow update: if isConversationMember(conversationId) &&
        request.auth.uid in resource.data.memberIds &&
        request.resource.data.memberIds == resource.data.memberIds;

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isConversationMember(conversationId);
        allow create: if isConversationMember(conversationId) &&
          request.resource.data.senderId == request.auth.uid;
        allow update: if isConversationMember(conversationId);
        allow delete: if false;
      }
    }
  }
}
